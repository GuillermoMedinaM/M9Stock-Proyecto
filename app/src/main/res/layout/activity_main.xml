<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181A1F">

    <!-- Cabecera elegante M9 Granada con logo centrado -->
    <LinearLayout
        android:id="@+id/headerM9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#20232A"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLogoM9"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="Logo M9 Stock"
            android:scaleType="fitCenter"
            android:src="@drawable/m9_stock_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.14"
            android:text="M9 GRANADA"
            android:textColor="#C8A96E"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Vestidos de Fiesta y Comunión · C/ Ribera del Beiro, 26"
            android:textColor="#A7B0C0"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvEstadoRed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Conectado · Sincronización activa"
            android:textColor="#8FD19E"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Vista 1, 2 y 3: Stock filtrado por pestaña (Tienda / Almacén / Modista y otros) -->
    <ScrollView
        android:id="@+id/vistaStock"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="18dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavM9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerM9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTituloSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock en Tienda"
                android:textColor="#F2F4F8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtituloSeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Prendas disponibles en exposición y venta"
                android:textColor="#9AA3B2"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvListadoSeccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#22252C"
                android:lineSpacingExtra="5dp"
                android:padding="16dp"
                android:text="Cargando inventario..."
                android:textColor="#E6E9EF"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Vista 4: Panel de Control (Alta, Sincronización y Estadísticas Globales) -->
    <ScrollView
        android:id="@+id/vistaControl"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="18dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomNavM9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerM9">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Panel de Control y Estadísticas"
                android:textColor="#F2F4F8"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEstadisticasGlobales"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#22252C"
                android:lineSpacingExtra="5dp"
                android:padding="16dp"
                android:text="Estadísticas globales..."
                android:textColor="#E6E9EF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp"
                android:text="Registrar o mover prenda"
                android:textColor="#C8A96E"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etReferencia"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="#252932"
                android:gravity="center_vertical"
                android:hint="Referencia o modelo (ej. F-204 Gala Burdeos)"
                android:paddingHorizontal="14dp"
                android:textColor="#F2F4F8"
                android:textColorHint="#8892A4" />

            <EditText
                android:id="@+id/etCategoria"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="#252932"
                android:gravity="center_vertical"
                android:hint="Tipo (Fiesta / Comunión)"
                android:paddingHorizontal="14dp"
                android:textColor="#F2F4F8"
                android:textColorHint="#8892A4" />

            <Spinner
                android:id="@+id/spUbicacion"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="14dp"
                android:background="#252932"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/btnGuardarLocal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:backgroundTint="#C8A96E"
                android:text="Guardar Prenda"
                android:textColor="#181A1F"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSincronizarAhora"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#2B303B"
                android:text="Sincronizar pendientes con Firebase"
                android:textColor="#F2F4F8" />
        </LinearLayout>
    </ScrollView>

    <!-- Barra inferior estilo Instagram / X -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavM9"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#20232A"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconTint="#C8A96E"
        app:itemTextColor="#C8A96E"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_nav_m9" />

</androidx.constraintlayout.widget.ConstraintLayout>