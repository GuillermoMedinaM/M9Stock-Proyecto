<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181A1F"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Logo M9 Stock -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivLogoLoginM9"
        android:layout_width="136dp"
        android:layout_height="136dp"
        android:layout_marginBottom="14dp"
        android:contentDescription="Logo M9 Stock"
        android:scaleType="centerCrop"
        android:src="@drawable/m9_stock_logo"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.M9.LogoEsquinasRedondas"
        app:strokeColor="#C8A96E"
        app:strokeWidth="2dp" />

    <!-- Título de la App -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="M9 STOCK"
        android:textColor="#C8A96E"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="28dp"
        android:gravity="center"
        android:text="Control de Inventario · M9 Granada"
        android:textColor="#A7B0C0"
        android:textSize="13sp" />

    <!-- Campo Correo -->
    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="14dp"
        android:background="#252932"
        android:hint="Correo de administrador"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="14dp"
        android:textColor="#F2F4F8"
        android:textColorHint="#8892A4"
        android:textSize="14sp" />

    <!-- Campo Contraseña -->
    <EditText
        android:id="@+id/etPassword"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="22dp"
        android:background="#252932"
        android:hint="Contraseña"
        android:inputType="textPassword"
        android:paddingHorizontal="14dp"
        android:textColor="#F2F4F8"
        android:textColorHint="#8892A4"
        android:textSize="14sp" />

    <!-- Botón de Inicio de Sesión -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#C8A96E"
        android:text="Iniciar Sesión"
        android:textColor="#181A1F"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
